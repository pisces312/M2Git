<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!--
      文件列表的排序入口。orderInCategory 给 0，比搜索（1）还小，所以它落在工具栏最左。
      和搜索一样按 tab 控制可见性（RepoDetailActivity#onPageSelected）：只有文件页有排序可言，
      提交页的顺序是提交历史、状态页是变更集，都不该被这个开关影响。
    -->
    <item
        android:id="@+id/action_sort_files"
        android:icon="@drawable/ic_action_sort"
        android:orderInCategory="0"
        android:title="@string/action_sort"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_search"
        android:icon="@drawable/ic_search"
        android:orderInCategory="1"
        android:title="@string/action_search"
        android:visible="false"
        app:actionViewClass="android.widget.SearchView"
        app:showAsAction="always|collapseActionView" />
    <!--
      标签入口：列表页长按进，详情页从这里进。图标复用列表页筛选条那个白色 label 轮廓
      （ic_action_filter_tags），两个主题的 ActionBar 都是深色，直接用，不新增资源。
      orderInCategory 比抽屉按钮小，所以它排在抽屉按钮左边 —— 只靠「声明在前」依赖的是
      ActionMenuPresenter 的隐式行为，显式写死更稳。
      它现在是唯一的溢出项，提成 always 之后溢出菜单为空，三点自动消失。
    -->
    <item
        android:id="@+id/action_edit_tags"
        android:icon="@drawable/ic_action_filter_tags"
        android:orderInCategory="2"
        android:title="@string/label_edit_tags"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_toggle_drawer"
        android:icon="@drawable/ic_drawer"
        android:orderInCategory="3"
        android:title="@string/action_toggle_drawer"
        app:showAsAction="always" />
</menu>
