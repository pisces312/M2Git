<layout>

    <data>

        <variable
            name="viewModel"
            type="ts.realms.m2git.ui.screens.main.RepoListViewModel" />

        <variable
            name="cloneViewModel"
            type="ts.realms.m2git.ui.screens.main.CloneViewModel" />

        <variable
            name="clickHandler"
            type="ts.realms.m2git.ui.common.interfaces.OnActionClickListener" />
    </data>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:bind="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context="ts.realms.m2git.ui.screens.main.RepoListActivity">

        <include
            android:id="@+id/cloneViewInclude"
            layout="@layout/clone_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            bind:clickHandler="@{clickHandler}"
            bind:viewModel="@{cloneViewModel}" />

        <!--
          常驻筛选条：选中的标签一直显示在列表上方，往下翻仓库时也能随时看到当前筛的是什么。
          左边是匹配方式（全部/任一，点一下切换），中间是已选标签（点标签即取消该筛选），
          右边是命中数与「清除」。没有筛选时整条连同分隔线一起隐藏，列表位置不变。
        -->
        <LinearLayout
            android:id="@+id/repoFilterBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/colorBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/general_padding_larger"
            android:paddingTop="@dimen/repo_filter_bar_padding_vertical"
            android:paddingRight="@dimen/general_padding_larger"
            android:paddingBottom="@dimen/repo_filter_bar_padding_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/filterMatchMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingLeft="@dimen/general_padding"
                android:paddingTop="@dimen/repo_filter_chip_padding_vertical"
                android:paddingRight="@dimen/general_padding"
                android:paddingBottom="@dimen/repo_filter_chip_padding_vertical"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/repo_filter_text_size" />

            <HorizontalScrollView
                android:id="@+id/filterChipsScroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/general_padding"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/filterChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/filterCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/general_padding"
                android:textColor="@color/general_gray_text_color"
                android:textSize="@dimen/repo_filter_text_size" />

            <TextView
                android:id="@+id/filterClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/general_horizontal_margin"
                android:minWidth="0dp"
                android:paddingLeft="@dimen/general_padding"
                android:paddingTop="@dimen/repo_filter_chip_padding_vertical"
                android:paddingRight="@dimen/general_padding"
                android:paddingBottom="@dimen/repo_filter_chip_padding_vertical"
                android:text="@string/label_clear_filter"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/repo_filter_text_size" />
        </LinearLayout>

        <View
            android:id="@+id/repoFilterDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/repoList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="?android:attr/listDivider" />

            <!-- 空列表提示：无仓库 与 筛选后无命中 是两回事，文案由代码按是否处于筛选态切换 -->
            <TextView
                android:id="@+id/repoListEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="@dimen/general_padding_larger"
                android:textColor="@color/general_gray_text_color"
                android:textSize="@dimen/repo_list_empty_text_size"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>
</layout>
