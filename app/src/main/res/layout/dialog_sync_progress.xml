<?xml version="1.0" encoding="utf-8"?>
<!--
  sync 的全屏进度对话框内容：暗背景由 Dialog 窗口的 dim 提供，这里是一张居中卡片，
  结构与详情页 pullProgressContainer 一致（消息 + 横向进度条 + 左右计数），观感统一。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/general_horizontal_margin"
        android:background="@drawable/bg_listitem"
        android:orientation="vertical"
        android:padding="@dimen/general_padding_larger">

        <TextView
            android:id="@+id/syncProgressMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/default_text"
            android:textColor="@color/general_gray_text_color"
            android:textSize="@dimen/file_list_header_msg_size" />

        <ProgressBar
            android:id="@+id/syncProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/syncLeftHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="@string/default_text"
                android:textColor="@color/general_gray_text_color"
                android:textSize="@dimen/file_list_header_hint_size" />

            <TextView
                android:id="@+id/syncRightHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="@string/default_text"
                android:textColor="@color/general_gray_text_color"
                android:textSize="@dimen/file_list_header_hint_size" />
        </RelativeLayout>
    </LinearLayout>

</FrameLayout>
